[mcu]
serial: /dev/serial/by-id/usb-Klipper_xxx
restart_method: command

[printer]
kinematics: cartesian
max_velocity: 400
max_accel: 4000
max_z_velocity: 15
max_z_accel: 100

# X coordinates, measured on this machine rather than estimated. Homing was run,
# then the carriage jogged left until it reached the end of the rail 900 mm from
# the trip point. position_endstop is set 20 mm short of that, so X0 sits clear
# of the hard stop: the crash point is not known precisely, and any error here
# propagates into every plant position.
#
# Measure these against your own switch mounting -- see deploy/README.md.
#
# Homing at the motor end keeps the belt span between pulley and carriage at its
# shortest when the switch trips, so the reference is the most repeatable point
# on the rail.
[stepper_x]
step_pin: PB13
# Negated to match this build. Which way a stepper turns depends on the order
# of its coil pairs in the connector and on how the belt is routed, so this is
# a property of the machine rather than of the board -- a differently wired
# motor may need the plain PB12. Check it with FORCE_MOVE before ever running
# G28, because homing_positive_dir sends homing toward the switch at 40 mm/s
# and the wrong sign drives into the far end of the rail instead. The procedure
# is in deploy/README.md.
dir_pin: !PB12
enable_pin: !PB14
microsteps: 16
rotation_distance: 40
# Normally-closed switch. ^ enables the internal pull-up; no ! because a closed
# contact already pulls the pin low, which is the untriggered reading. ^!PC0
# would be the normally-OPEN config -- the inverse of what this build wants, and
# it would give up the fail-safe described in deploy/README.md.
endstop_pin: ^PC0
position_min: 0
position_max: 880
position_endstop: 880
# Stated rather than inferred: Klipper would work this out from position_endstop
# sitting at the top of the range, but then a later edit to position_max could
# silently reverse the homing direction.
homing_positive_dir: True
homing_speed: 40
second_homing_speed: 10
homing_retract_dist: 5

[tmc2209 stepper_x]
uart_pin: PC11
tx_pin: PC10
uart_address: 0
run_current: 0.7
stealthchop_threshold: 999999

# Park clear of the switch after homing so the first move in either direction
# is legal; sitting on position_max makes any rightward jog fail.
[homing_override]
axes: x
gcode:
    # Plain G28, not G28.1. G28.1 is a Marlin command and Klipper answers
    # "Unknown command", which left the override failing on its first line and
    # the move below refusing with "Must home axis first". Calling G28 from
    # inside the override does not recurse: homing_override sets a flag while
    # its script runs and dispatches a nested G28 to the real homing routine.
    G28 X
    G90
    G1 X860 F3000

[force_move]
enable_force_move: True

# Non-contact liquid sensor clamped on the outlet tube's falling leg -- after the
# high point, before the nozzle. That is the only stretch of the water path that
# drains between doses, so it is the only one with a signal in it; the rising leg
# is sealed by the stopped pump and reads wet forever. It verifies that a dose
# delivered rather than gating watering -- see deploy/README.md.
#
# Declared as a filament sensor purely because that exposes the pin state through
# objects/query; runout handling is off, the watering logic owns the decision.
# Flip to ^!PC1 if a full tube reads as empty.
#
# This owns Y-STOP (PC1). stepper_y below is a placeholder and gives the pin up.
[filament_switch_sensor water_supply]
switch_pin: ^PC1
pause_on_runout: False

# Y and Z are placeholders with no motor and no switch wired to them. The gantry
# has one axis, but kinematics: cartesian requires all three stepper sections to
# exist, so they are declared and never used.
#
# Their endstop pins point at the unused E0-STOP (PC15) and PROBE (PC14) headers
# rather than at Y-STOP and Z-STOP. stepper_y used to claim ^!PC1, which the water
# sensor also needs; Klipper resolves an endstop and a button as different share
# types on the same pin and refuses the whole config with "pin PC1 used multiple
# times in config". Keeping the placeholders off PC1 and PC2 leaves Y-STOP to the
# water sensor and Z-STOP genuinely free as a spare input. Nothing is plugged into
# a placeholder pin, so it only has to be valid and unclaimed.
#
# The pullup is deliberately not inverted here, unlike X. An unconnected pin with
# a pullup reads high, which these two read as already triggered, so a stray G28 Y
# or G28 Z fails after a 5 mm retract instead of running a phantom 200 mm traverse
# first. Neither axis should be homed at all -- the motion API will let you try.
[stepper_y]
step_pin: PB10
dir_pin: PB2
enable_pin: !PB11
microsteps: 16
rotation_distance: 40
endstop_pin: ^PC15
position_min: 0
position_max: 200
position_endstop: 0

[tmc2209 stepper_y]
uart_pin: PC11
tx_pin: PC10
uart_address: 1
run_current: 0.7
stealthchop_threshold: 999999

[stepper_z]
step_pin: PB0
dir_pin: PC5
enable_pin: !PB1
microsteps: 16
rotation_distance: 8
endstop_pin: ^PC14
position_min: 0
position_max: 200
position_endstop: 0

[tmc2209 stepper_z]
uart_pin: PC11
tx_pin: PC10
uart_address: 2
run_current: 0.7
stealthchop_threshold: 999999

[virtual_sdcard]
path: ~/printer_data/gcodes

[pause_resume]

[display_status]
[respond]

# Pump on the HE0 MOSFET, switching whatever the board is fed (12V here).
# Deliberately not a [heater_generic]: that requires a temperature sensor, and
# verify_heater would fault mid-dose when commanded heat produces no rise.
# shutdown_value stops the pump if Klipper errors out partway through watering.
[output_pin pump]
pin: PC8
value: 0
shutdown_value: 0

[gcode_macro HOME_GANTRY]
description: Home the gantry on the X axis
gcode:
    G28 X

[gcode_macro MOVE_LEFT_10]
description: Move gantry left by 10 mm
gcode:
    G91
    G1 X-10 F6000
    G90

[gcode_macro MOVE_RIGHT_10]
description: Move gantry right by 10 mm
gcode:
    G91
    G1 X10 F6000
    G90
