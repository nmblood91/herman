# Klipper build options for the BTT SKR Mini E3 V2, as chosen in
# `make menuconfig`. build-firmware.sh copies this to klipper/.config, runs
# `make olddefconfig` to fill in everything derived from these, and builds
# firmware.bin beside it from the commit in ../KLIPPER_COMMIT, so the firmware
# and the Pi's Klipper always come from the same source.
#
# Read back out of the firmware.bin that was flashed and working: Klipper
# 2d7717e, MCU stm32f103xe, 72 MHz, USB on PA11/PA12, initial pins !PA14.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
# 28 KiB bootloader: the board's stock SD-card bootloader.
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_USB_PA11_PA12=y
# Drives PA14 low at power-on. The board needs it to bring USB up.
CONFIG_INITIAL_PINS="!PA14"
