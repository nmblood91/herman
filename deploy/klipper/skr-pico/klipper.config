# Klipper build options for the BTT SKR Pico V1.0, as chosen in
# `make menuconfig`. build-firmware.sh copies this to klipper/.config, runs
# `make olddefconfig` to fill in everything derived from these, and builds
# firmware.uf2 beside it from the commit in ../KLIPPER_COMMIT, so the firmware
# and the Pi's Klipper always come from the same source.
#
# From BTT's SKR-Pico/Klipper/README.md: RP2040, no bootloader, GENERIC_03H
# flash at CLKDIV 4. Talks to the Pi over UART0 on GPIO0/GPIO1, the 5-pin
# header that also feeds the Pi 5V, rather than over USB. The USB-C port stays
# the recovery path whatever this firmware does: the RP2040's boot ROM, entered
# with the Boot jumper, is not part of it.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_0100=y
CONFIG_RP2040_FLASH_GENERIC_03=y
CONFIG_RPXXXX_SERIAL_UART0_PINS_0_1=y
