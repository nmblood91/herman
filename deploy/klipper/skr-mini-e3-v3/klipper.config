# Klipper build options for the BTT SKR Mini E3 V3, as chosen in
# `make menuconfig`. build-firmware.sh copies this to klipper/.config, runs
# `make olddefconfig` to fill in everything derived from these, and builds
# firmware.bin beside it from the commit in ../KLIPPER_COMMIT, so the firmware
# and the Pi's Klipper always come from the same source.
#
# From Klipper's config/generic-bigtreetech-skr-mini-e3-v3.0.cfg: STM32G0B1,
# 8 KiB bootloader, USB. Unlike the V2, no startup pin is needed for USB.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32G0B1=y
# 8 KiB bootloader: the board's stock SD-card bootloader.
CONFIG_STM32_FLASH_START_2000=y
# The board's 8 MHz crystal. The prompt only shows with low-level options on,
# which is why those are enabled above.
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_USB_PA11_PA12=y
