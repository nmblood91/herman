[Unit]
Description=Check for a newer GreenThumb package daily

[Timer]
# Only checks, so the UI can say an update is available. Installing it is
# always the user's choice, from the Update button.
OnBootSec=5min
OnUnitActiveSec=1d
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
