APP_NAME=GreenThumb
API_PREFIX=/api/v1
DEBUG=false

# --- Motion ---
KLIPPER_HOST=/run/klipper/uds
GANTRY_RAIL_LENGTH_MM=1000
GANTRY_POSITION_MARGIN_MM=20

# --- Soil sensors ---
# I2C addresses for STEMMA soil sensors: 54=0x36, 55=0x37, 56=0x38, 57=0x39
MOISTURE_SENSOR_ADDRESSES=54,55,56,57
# Fallback raw readings that map to 0% and 100%, used only for sensors that
# have not been calibrated. Prefer calibrating, which measures each sensor
# individually and stores the result in data/state.json:
#
#   .venv/bin/python -m greenthumb.hardware.soil_sensors --calibrate dry
#   .venv/bin/python -m greenthumb.hardware.soil_sensors --calibrate wet
#
# Sensors read measurably differently from each other in identical conditions,
# so one global pair puts that spread straight into the reported percentage.
# See SENSOR_WIRING.md.
MOISTURE_RAW_DRY=320
MOISTURE_RAW_WET=1020

# --- Control loop ---
SENSOR_POLL_SECONDS=60
# Watering uses the mean of this many polls, so 10 at 60s is a 10 minute trend.
MOISTURE_WINDOW_SIZE=10
# The starting value only -- the Settings tab owns this switch and saves any
# change to data/state.json, which wins over this line on the next start.
# Leave off until the pump has been tested by hand and the flow rate measured.
AUTO_WATERING_ENABLED=false
WATERING_COOLDOWN_MINUTES=30

# --- Idle motion ---
# Re-home and run a short routine on this interval. The re-home is the point:
# steppers are open-loop, so a slipped belt or a nudged carriage leaves every
# plant position wrong until the next home. Held during quiet hours and a
# snooze. Defaults only; the Settings tab persists changes to data/state.json.
IDLE_MOTION_ENABLED=true
IDLE_MOTION_MINUTES=60

# --- Quiet hours ---
# Holds off AUTOMATIC watering and idle motion in a nightly window -- the pump
# and the gantry are the loud parts. Watering you start yourself is never blocked, and a plant
# that comes due during the window is watered when it ends rather than skipped.
# A stop before the start runs overnight. These are defaults; changing them in
# the Settings tab persists to data/state.json and wins over these.
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=21:00
QUIET_HOURS_STOP=08:00

# --- Delivery verification ---
# Confirms that a dose actually delivered water. Needs the liquid sensor wired
# to Y-STOP, clamped to the OUTLET tube on the falling leg before the nozzle,
# and its polarity confirmed first. This never blocks a dose: the outlet drains
# between waterings, so it reads dry when idle and a pre-check would refuse
# everything. It watches during the pour instead and flags one that delivered
# nothing.
WATER_SENSOR_ENABLED=false
# Seconds to wait after the pump starts before the first look, so the falling
# leg has time to fill. Raise it if that leg is unusually long.
DELIVERY_CHECK_DELAY_SECONDS=5.0

# --- Pump ---
# Matches the [output_pin] section name in printer.cfg (pump is on HB/PC9)
PUMP_PIN_NAME=pump
# 100 mL/min rated = 1.67 mL/s, before head pressure and tubing losses.
# Measure against a real dose: this converts millilitres into a pump run time.
PUMP_FLOW_ML_PER_SECOND=1.67
# Dead-man limit for the manual run button in the UI, not a dosing figure. The
# pump stops at this even if the browser is closed or the network drops, which
# is what keeps a forgotten manual run from emptying the reservoir.
PUMP_MAX_RUN_SECONDS=120

# --- History ---
# Every reading is stored in SQLite for the History chart. At one poll a minute
# across four sensors this is roughly 26 MB at 90 days, after which it plateaus.
HISTORY_RETENTION_DAYS=90
# Blank uses data/greenthumb.db alongside the app, like logs/.
HISTORY_DB_PATH=

# --- Lighting ---
# Strip chip, selectable in the settings page. Sets the signal timing and the
# usual channel order. All supported chips are 12V: WS2815 and GS8208 give one
# pixel per LED, WS2811 drives three LEDs per pixel so LED_COUNT is LEDs/3.
# No 5V chip is offered; see POWER_SYSTEM.md for why.
LED_CHIP=WS2811
# Addressable pixels, not LEDs. Data goes out on SPI MOSI (GPIO10, pin 19).
LED_COUNT=60
# Overrides the chip's usual order, for strips wired differently.
LED_COLOR_ORDER=GRB
LED_SPI_BUS=0
LED_SPI_DEVICE=0
